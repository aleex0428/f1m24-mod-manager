{
  "$schema": "https://schema.tauri.app/config/2/capability.json",
  "identifier": "default",
  "description": "Main window. Kept to the minimum the UI actually uses: events, the folder picker, and opening a mod page in the default browser. File access happens in Rust commands, so no fs permissions are granted to the frontend.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-progress-bar",
    "core:window:allow-close",
    "core:app:default",
    "core:path:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
