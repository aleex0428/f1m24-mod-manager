{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "F1M24 Mod Manager",
  "version": "1.2.0",
  "identifier": "gg.overtake.f1m24-mod-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "F1M24 Mod Manager",
        "width": 1200,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "url": "index.html",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://www.overtake.gg https://*.overtake.gg; img-src 'self' data: blob: asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "f1m24"
        ]
      }
    },
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://github.com/aleex0428/f1m24-mod-manager/releases/latest/download/latest.json",
        "https://aleex0428.github.io/f1m24-mod-manager/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0M0E2NEJGRUZDRUFENUYKUldSZnJjN3Z2MlE2cERvb1hNTE5Jd21uQkpIS2c0bE9jL2ZtZUcvNXRqd2J5N3hVNVFuazVrc1QK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "licenseFile": "../LICENSE",
    "publisher": "F1M24 Mod Manager",
    "copyright": "F1M24 Mod Manager",
    "category": "Utility",
    "shortDescription": "Mod manager for F1 Manager 24",
    "longDescription": "Install, enable and order F1 Manager 24 mods from Overtake.gg, with conflict detection and one-click launching.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "externalBin": [
      "binaries/sevenza"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "perMachine",
        "sidebarImage": "installer_sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
